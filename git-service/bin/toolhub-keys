#!/usr/bin/python3
"""sshd AuthorizedKeysCommand: `toolhub-keys %u %f`.

In ra đúng MỘT dòng authorized_keys (forced command + chặn mọi forwarding/pty) nếu fingerprint hợp lệ.
"""
import sys
import urllib.parse

sys.path.insert(0, "/opt/toolhub/lib")
from toolhub_common import api, err  # noqa: E402

OPTIONS = "no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty,no-user-rc"


def main() -> int:
    if len(sys.argv) < 3 or sys.argv[1] != "git":
        return 0
    fingerprint = sys.argv[2]
    try:
        status, data = api("GET", "/git/ssh-keys/lookup?fingerprint=" + urllib.parse.quote(fingerprint), timeout=5)
    except OSError as exc:
        err(f"toolhub-keys: API unreachable: {exc}")
        return 0
    if status != 200 or not data.get("key_id"):
        return 0
    key_id = data["key_id"]
    if not all(c in "0123456789abcdef-" for c in key_id):
        return 0
    print(f'command="/opt/toolhub/bin/toolhub-git-auth {key_id}",{OPTIONS} {data["public_key"]}')
    return 0


if __name__ == "__main__":
    sys.exit(main())
