# ─────────────────────────────────────────────────────────────────────────────
# HAWEE Tool Hub — hợp đồng cấu hình. Copy thành deploy/.env rồi điền, chmod 600.
# KHÔNG commit deploy/.env. Sinh secret: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=staging                      # staging | production (production bắt buộc secret >= 32 ký tự)
APP_NAME=HAWEE Tool Hub
LOG_LEVEL=INFO
TOOLHUB_TAG=1.0.0                    # tag image (CI/CD đặt = 7 ký tự đầu commit SHA)

# URL người dùng nhìn thấy (hiển thị lệnh pip/clone trên UI)
WEB_BASE_URL=http://SERVER_IP:8080
PACKAGE_BASE_URL=http://SERVER_IP:8081
GIT_SSH_HOST=SERVER_IP
GIT_SSH_PORT=2222
GIT_SSH_BIND=0.0.0.0
WEB_PORT=8080
PACKAGES_PORT=8081
CORS_ORIGINS=                        # để trống: UI và API cùng origin qua nginx
COOKIE_SECURE=false                  # true khi chạy HTTPS (production)

# Production HTTPS (deploy/docker-compose.prod.yml)
TOOLS_HOST=tools.hawee.local
PACKAGES_HOST=packages.hawee.local
CERTS_DIR=../certs                   # chứa server.crt + server.key do IT cấp

# PostgreSQL
POSTGRES_USER=toolhub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=toolhub

# Secrets (mỗi cái một giá trị ngẫu nhiên riêng, >= 32 ký tự)
JWT_SECRET=CHANGE_ME
INTERNAL_SERVICE_SECRET=CHANGE_ME    # git-service ↔ API nội bộ
RUNNER_TOKEN=CHANGE_ME               # worker ↔ API (bootstrap đăng ký dạng hash)

# MinIO (object storage cho package, log, artifact)
MINIO_ACCESS_KEY=toolhub
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_PACKAGES=toolhub-packages
MINIO_BUCKET_LOGS=toolhub-build-logs
MINIO_BUCKET_ARTIFACTS=toolhub-artifacts
MINIO_BUCKET_BACKUPS=toolhub-backups

# Registry
INTERNAL_PACKAGE_PREFIX=hawee-       # KHÔNG đổi sau khi đã publish package (luật chống dependency confusion)
PYPI_UPSTREAM_SIMPLE_URL=https://pypi.org/simple
PYPI_UPSTREAM_FILE_HOSTS=files.pythonhosted.org
PYPI_METADATA_TTL_SECONDS=900
REGISTRY_ALLOW_ANONYMOUS=false       # true = pip không cần token (chỉ nên bật trong mạng tin cậy)
PACKAGE_MAX_UPLOAD_MB=500

# Build
BUILD_MAX_CONCURRENCY=2
BUILD_TIMEOUT_SECONDS=900
BUILD_MEMORY_LIMIT=4g
BUILD_CPU_LIMIT=2
BUILD_STORAGE_SIZE=                  # vd 5G — chỉ khi Docker dùng overlay2 trên xfs có pquota
BUILDER_IMAGE=toolhub-builder:1.0.0
RUNNER_NAME=runner-1

# Rate limit
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=600
REGISTRY_RATE_LIMIT_PER_MINUTE=6000
UVICORN_WORKERS=1

# Bootstrap (chỉ dùng khi chưa có admin; không đổi mật khẩu admin đã tồn tại)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@hawee.local
FIRST_ADMIN_PASSWORD=CHANGE_ME
